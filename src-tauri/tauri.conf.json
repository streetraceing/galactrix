{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Galactrix",
  "version": "1.0.0",
  "identifier": "ru.streetraceing.galactrix",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Galactrix",
        "width": 1280,
        "height": 720,
        "center": true,
        "maximized": true,
        "resizable": true,
        "minWidth": 640,
        "minHeight": 520,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
