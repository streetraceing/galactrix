{
  "name": "galactrix",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  },
  "scripts": {
    "prepare": "husky",
    "prettier:write": "prettier . --write",
    "i18n:check": "node scripts/check-i18n.mjs",
    "test": "tsx --test test/frontend/*.test.ts",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check": "npm run version:check && npm run i18n:check && npm run test && npm run typecheck && npm run lint",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev:pc": "npm run tauri -- dev",
    "tauri:dev:android": "scripts\\android-dev.cmd",
    "npm:patch": "npm run version:patch",
    "npm:minor": "npm run version:minor",
    "npm:major": "npm run version:major",
    "version:check": "node scripts/version.mjs check",
    "version:sync": "node scripts/version.mjs sync",
    "version:set": "node scripts/version.mjs set",
    "version:patch": "node scripts/version.mjs patch",
    "version:minor": "node scripts/version.mjs minor",
    "version:major": "node scripts/version.mjs major",
    "tauri:build:desktop": "tauri build",
    "tauri:build:android": "tauri android build",
    "tauri:build:android:apk": "tauri android build --apk",
    "tauri:build:android:ci": "tauri android build --debug --target aarch64 --apk --ci",
    "release:build:local": "npm run release:prepare && npm run tauri:build:all",
    "release:prepare": "npm run check",
    "release:prepare:patch": "npm run version:patch && npm run release:prepare",
    "release:prepare:minor": "npm run version:minor && npm run release:prepare",
    "release:prepare:major": "npm run version:major && npm run release:prepare",
    "tauri:build:all": "npm run tauri:build:desktop && npm run tauri:build:android",
    "release:tag": "node scripts/version.mjs tag"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@heroui/react": "^3.2.2",
    "@heroui/styles": "^3.2.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "clsx": "^2.1.1",
    "i18next": "^26.3.6",
    "lucide-react": "^1.26.0",
    "next-themes": "^0.4.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.11",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.1.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^10.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.1",
    "prettier": "3.9.6",
    "tsx": "^4.23.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.0.4"
  },
  "engines": {
    "node": ">=22.22.1"
  }
}
